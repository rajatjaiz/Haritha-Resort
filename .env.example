# ---- App ----
PORT=3000
# REQUIRED on Vercel: choose a strong PIN (the dev default 1234 is refused in production)
ADMIN_PIN=
# e.g. https://haritha-resort.vercel.app  (used in WhatsApp links, QR codes, feedback links)
PUBLIC_URL=

# ---- Supabase (Postgres) ----
# Supabase dashboard > Connect > "Transaction pooler" connection string (port 6543). Needs the database password.
DATABASE_URL=
# Supabase API keys (not used by the server today; for the Supabase MCP / future client-side use). Project URL:
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ---- WhatsApp Cloud API (Meta) ----
WHATSAPP_API_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_DISPLAY_NUMBER=
# System User permanent token (the console's temporary token expires in ~24h)
WHATSAPP_ACCESS_TOKEN=
# App settings > Basic > App secret (verifies webhook signatures)
WHATSAPP_APP_SECRET=
# any random string; paste the same value in Meta's webhook configuration
WHATSAPP_VERIFY_TOKEN=
# optional approved template with 2 body variables {{1}}=guest name {{2}}=feedback link
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# ---- Razorpay ----
# rzp_test_xxx while testing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks; URL: {PUBLIC_URL}/api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# ---- Merchant profile used on receipts/invoices ----
# test = merchant block + "TEST RECEIPT" marking; live = resort details + GSTIN
INVOICE_MODE=test
MERCHANT_NAME=
MERCHANT_TYPE=
MERCHANT_PAN=
MERCHANT_CATEGORY=
MERCHANT_ADDRESS=
